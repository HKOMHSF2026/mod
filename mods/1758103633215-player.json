{
  "format_version": "1.17.10",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:player",
      "is_spawnable": false,
      "is_summonable": false,
      "is_experimental": false,
      "animations": {
        "death": "controller.animation.death",
        "gaining_life": "controller.animation.gaining_life",
        "giving_life": "controller.animation.giving_life",
        "killed_player": "controller.animation.killed_player",
        "prepare_give_life": "controller.animation.prepare_give_life"
      },
      "scripts": {
        "animate": [
          "death",
          "gaining_life",
          "giving_life",
          "killed_player",
          "prepare_give_life"
        ]
      }
    },
    "component_groups": {
      "minecraft:add_bad_omen": {
        "minecraft:spell_effects": {
          "add_effects": [
            {
              "effect": "bad_omen",
              "duration": 6000,
              "display_on_screen_animation": true
            }
          ]
        },
        "minecraft:timer": {
          "time": [ 0.0, 0.0 ],
          "looping": false,
          "time_down_event": {
            "event": "minecraft:clear_add_bad_omen",
            "target": "self"
          }
        }
      },
      "minecraft:clear_bad_omen_spell_effect": {
        "minecraft:spell_effects": {}
      },
      "minecraft:raid_trigger": {
        "minecraft:raid_trigger": {
          "triggered_event": {
            "event": "minecraft:remove_raid_trigger",
            "target": "self"
          }
        },
        "minecraft:spell_effects": {
          "remove_effects": "bad_omen"
        }
      },
      "ll:gaining_life": {
        "minecraft:is_illager_captain": {}
      },
      "ll:giving_life": {
        "minecraft:is_saddled": {}
      },
      "ll:killed_player": {
        "minecraft:is_chested": {}
      },
      "ll:prepare_give_life": {
        "minecraft:is_baby": {}
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "Math.Min(query.player_level * 7, 100)"
      },
      "minecraft:type_family": {
        "family": [
          "player"
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:loot": {
        "table": "loot_tables/empty.json"
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:can_climb": {},
      "minecraft:movement": {
        "value": 0.1
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:player.saturation": {
        "value": 20
      },
      "minecraft:player.exhaustion": {
        "value": 0,
        "max": 4
      },
      "minecraft:player.level": {
        "value": 0,
        "max": 24791
      },
      "minecraft:player.experience": {
        "value": 0,
        "max": 1
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": -1,
        "inhale_time": 3.75,
        "generates_bubbles": false
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:insomnia": {
        "days_until_insomnia": 3
      },
      "minecraft:rideable": {
        "seat_count": 2,
        "family_types": [
          "parrot_tame"
        ],
        "pull_in_entities": true,
        "seats": [
          {
            "position": [ 0.4, -0.2, -0.1 ],
            "min_rider_count": 0,
            "max_rider_count": 0,
            "lock_rider_rotation": 0
          },
          {
            "position": [ -0.4, -0.2, -0.1 ],
            "min_rider_count": 1,
            "max_rider_count": 2,
            "lock_rider_rotation": 0
          }
        ]
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:block_climber": {},
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "all_of": [
              {
                "test": "has_mob_effect",
                "value": "bad_omen"
              },
              {
                "test": "is_in_village"
              }
            ]
          },
          "event": "minecraft:trigger_raid"
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "value": "attack"
                  },
                  {
                    "test": "has_damage",
                    "value": "fatal"
                  },
                  {
                    "test": "has_tag",
                    "value": "ll:2plus_lives"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "ll:boogeyman"
                  }
                ]
              },
              "event": "ll:killed_player",
              "target": "other"
            }
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "value": "attack"
                  },
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:gaining_life"
                  },
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:giving_life"
                  },
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:prepare_give_life"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "ll:2plus_lives"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "ll:gaining_life"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "ll:giving_life"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "ll:prepare_give_life"
                  }
                ]
              },
              "event": "ll:gaining_life"
            },
            "deals_damage": false
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:gaining_life"
                  },
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:giving_life"
                  },
                  {
                    "test": "has_tag",
                    "operator": "!=",
                    "value": "ll:prepare_give_life"
                  },
                  {
                    "test": "is_sneaking",
                    "subject": "other"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "ll:2plus_lives"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "ll:gaining_life"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "ll:giving_life"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "ll:prepare_give_life"
                  }
                ]
              },
              "event": "ll:prepare_give_life",
              "target": "other"
            },
            "interact_text": "Give Life"
          }
        ]
      }
    },
    "events": {
      "minecraft:gain_bad_omen": {
        "add": {
          "component_groups": [
            "minecraft:add_bad_omen"
          ]
        }
      },
      "minecraft:clear_add_bad_omen": {
        "remove": {
          "component_groups": [
            "minecraft:add_bad_omen"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:clear_bad_omen_spell_effect"
          ]
        }
      },
      "minecraft:trigger_raid": {
        "add": {
          "component_groups": [
            "minecraft:raid_trigger"
          ]
        }
      },
      "minecraft:remove_raid_trigger": {
        "remove": {
          "component_groups": [
            "minecraft:raid_trigger"
          ]
        }
      },
      "ll:gaining_life": {
        "add": {
          "component_groups": [
            "ll:gaining_life"
          ]
        }
      },
      "ll:gaining_life_end": {
        "remove": {
          "component_groups": [
            "ll:gaining_life"
          ]
        }
      },
      "ll:giving_life": {
        "add": {
          "component_groups": [
            "ll:giving_life"
          ]
        }
      },
      "ll:giving_life_end": {
        "remove": {
          "component_groups": [
            "ll:giving_life"
          ]
        }
      },
      "ll:killed_player": {
        "add": {
          "component_groups": [
            "ll:killed_player"
          ]
        }
      },
      "ll:killed_player_end": {
        "remove": {
          "component_groups": [
            "ll:killed_player"
          ]
        }
      },
      "ll:prepare_give_life": {
        "add": {
          "component_groups": [
            "ll:prepare_give_life"
          ]
        }
      },
      "ll:prepare_give_life_end": {
        "remove": {
          "component_groups": [
            "ll:prepare_give_life"
          ]
        }
      }
    }
  }
}